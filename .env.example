# Copy to `.env` and adjust for your host, then run: docker compose up --build
#
# Directory of videos/images to scan (mounted read-only at /media/library).
# Leave unset to use the bundled samples/ directory (default).
# HOST_MEDIA_DIR=/path/to/media

# Host GIDs for GPU device access. Find them with:
#   getent group render   # -> RENDER_GID
#   getent group video    # -> VIDEO_GID
RENDER_GID=989
VIDEO_GID=985
