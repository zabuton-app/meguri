{
  "name": "meguri",
  "private": true,
  "version": "0.2.6",
  "description": "Meguri is a local video and image browser with thumbnails, search, and playback",
  "license": "MIT",
  "author": {
    "name": "amgsk",
    "email": "y.amgsk@gmail.com"
  },
  "homepage": "https://github.com/zabuton-app/meguri#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zabuton-app/meguri.git"
  },
  "bugs": {
    "url": "https://github.com/zabuton-app/meguri/issues"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "start": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:core && npm run test:renderer",
    "test:core": "ELECTRON_RUN_AS_NODE=1 NODE_OPTIONS=--experimental-require-module electron node_modules/vitest/vitest.mjs run --project core",
    "test:renderer": "vitest run --project renderer",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "install:local": "node scripts/install-local.mjs"
  },
  "engines": {
    "node": ">=22.22"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.3.1",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.14.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "embla-carousel-react": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.469.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tinykeys": "^3.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.5",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "dev.amgsk.meguri",
    "productName": "Meguri",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
    "afterPack": "scripts/mac-adhoc-sign.mjs",
    "protocols": [
      {
        "name": "Meguri",
        "schemes": [
          "meguri"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "appx"
      ]
    },
    "appx": {
      "identityName": "amgsk.meguri",
      "publisher": "CN=72C8C359-BF5B-4932-A8A6-9114D02CCAB3",
      "publisherDisplayName": "amgsk",
      "applicationId": "Meguri",
      "displayName": "Meguri"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "gatekeeperAssess": false
    }
  }
}
