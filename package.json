{
  "name": "meguri",
  "private": true,
  "version": "0.12.0",
  "description": "Meguri is a local video, image, and audio browser with thumbnails, search, and playback",
  "license": "MIT",
  "author": {
    "name": "amgsk",
    "email": "y.amgsk@gmail.com"
  },
  "homepage": "https://github.com/zabuton-app/meguri#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zabuton-app/meguri.git"
  },
  "bugs": {
    "url": "https://github.com/zabuton-app/meguri/issues"
  },
  "main": "out/main/main.js",
  "scripts": {
    "dev": "node scripts/run-electron-vite.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/run-electron-vite.mjs preview",
    "start": "node scripts/run-electron-vite.mjs preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p electron/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:core && npm run test:renderer",
    "test:core": "node scripts/test-core.mjs",
    "test:renderer": "vitest run --project renderer",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headless": "npm run build && MEGURI_FORCE_X11=1 MEGURI_E2E_XVFB=1 playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "install:local": "node scripts/install-local.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "pet:preview": "vite tools/pet-preview"
  },
  "engines": {
    "node": ">=22.22"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react"
    },
    "global-agent": "^4.1.3",
    "minimatch@^9.0.0 || ^10.0.0": "^11.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@zabuton-app/ffmpeg-binaries": "https://github.com/zabuton-app/ffmpeg-binaries/releases/download/v1.0.6/zabuton-app-ffmpeg-binaries-1.0.6.tgz",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force-3d": "3.0.6",
    "driver.js": "^1.14.0",
    "electron-log": "^5.4.4",
    "embla-carousel-react": "^8.6.0",
    "emoji-mart": "^5.6.0",
    "graphology": "^0.26.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sigma": "^3.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0",
    "tinykeys": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.19.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "assemblyscript": "0.28.20",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "graphology-types": "^0.24.8",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "dev.amgsk.meguri",
    "productName": "Meguri",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
    "afterPack": "scripts/mac-adhoc-sign.mjs",
    "protocols": [
      {
        "name": "Meguri",
        "schemes": [
          "meguri"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "THIRD_PARTY_NOTICES.txt"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/@zabuton-app/ffmpeg-binaries/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/!(linux-${arch}).node"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "appx"
      ],
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/!(win32-${arch}).node"
      ]
    },
    "appx": {
      "identityName": "amgsk.meguri",
      "publisher": "CN=72C8C359-BF5B-4932-A8A6-9114D02CCAB3",
      "publisherDisplayName": "amgsk",
      "applicationId": "Meguri",
      "displayName": "Meguri",
      "backgroundColor": "transparent"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${platform}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-${platform}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!**/node_modules/better-sqlite3/prebuilds/!(darwin-${arch}).node"
      ],
      "category": "public.app-category.video",
      "gatekeeperAssess": false
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "https://github.com/zabuton-app/ffmpeg-binaries/releases/download/v1.0.6/zabuton-app-ffmpeg-binaries-1.0.6.tgz": true,
    "better-sqlite3": false
  }
}
